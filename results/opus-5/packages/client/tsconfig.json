{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDir": "./src",
    "outDir": "./dist-types",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../shared" }]
}
